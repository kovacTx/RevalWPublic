@using RevalW.Shared.Model;
@using RevalW.Shared.Utils;
@using RevalW.Services.Shared.Utils;
@{
    var isLogged = User?.Identity?.IsAuthenticated == true;
    var canAddItems = User?.IsAuthorized(RightsList.Item_Create) ?? true;
    var isCreator = isLogged && User?.IsInRole(ERoles.Creator) == true;
    var isUberAdmin = isLogged && User?.IsInRole(ERoles.UberAdmin) == true;
}
@section Meta {
    <meta name="description" content="Create and manage the items for the dynamic forms of the RevalW Agenda." />
    <meta property="og:title" content="Items Management | RevalW Agenda" />
}
@model IEnumerable<ItemHeaderDto>
@{
    ViewData["Title"] = "Items";

    var status = Context.Request.Query["status"];

    var statusNewClass = "";
    var statusExportedClass = "";
    var statusImportedClass = "";
    var statusFinishedClass = "";
    var statusReadonlyClass = "";
    var statusDeletedClass = "";
    var statusAllClass = "";

    switch (status)
    {
        default:
            statusNewClass = "active text-white bg-secondary";
            break;
        case nameof(EItemStatus.Exported):
            statusExportedClass = "active text-white bg-secondary";
            break;
        case nameof(EItemStatus.Imported):
            statusImportedClass = "active text-white bg-secondary";
            break;
        case nameof(EItemStatus.Finished):
            statusFinishedClass = "active text-white bg-secondary";
            break;
        case nameof(EItemStatus.Readonly):
            statusReadonlyClass = "active text-white bg-secondary";
            break;
        case nameof(EItemStatus.Deleted):
            statusDeletedClass = "active text-white bg-secondary";
            break;
        case "All":
            statusAllClass = "active text-white bg-secondary";
            break;
    }
}
<style>
    .modal-80 {
        width: 600px !important;
        max-width: none;
    }

    /* Resizable table styling */
    #tblData {
        table-layout: fixed; /* recommended for column resize plugins */
        width: 100% !important;
    }
    #tblData th, #tblData td {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    #tblData .grip {
        width: 8px;
        height: 100%;
        background: transparent;
    }
    .dragging {
        /* no-op, reserved for plugin */
    }

    .tableContainer {
        min-width: 550px;
    }

</style>
<div class="card shadow border-0 mt-4 tableContainer">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3 d-flex justify-content-between">
        <h1 class="text-white" style="white-space: nowrap;">Item List</h1>
        <button class="btn btn-primary d-lg-none ms-auto me-3"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#statusMenu">
            ☰ Status
        </button>
        <div class="collapse d-lg-block" id="statusMenu">
            <ul class="list-group list-group-horizontal-lg pt-2 ms-auto me-3">
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex">
                    <li class="list-group-item @statusNewClass">New</li>
                </a>
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex" asp-route-status="@EItemStatus.Exported">
                    <li class="list-group-item @statusExportedClass">Exported</li>
                </a>
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex" asp-route-status="@EItemStatus.Imported">
                    <li class="list-group-item @statusImportedClass">Imported</li>
                </a>
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex" asp-route-status="@EItemStatus.Finished">
                    <li class="list-group-item @statusFinishedClass">Finished</li>
                </a>
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex" asp-route-status="@EItemStatus.Readonly">
                    <li class="list-group-item @statusReadonlyClass">Readonly</li>
                </a>
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex" asp-route-status="@EItemStatus.Deleted">
                    <li class="list-group-item @statusDeletedClass">Deleted</li>
                </a>
                <a class="text-decoration-none" asp-controller="Items" asp-action="ItemIndex" asp-route-status="All">
                    <li class="list-group-item @statusAllClass">All</li>
                </a>
            </ul>
        </div>
        @if (isLogged && canAddItems)
        {
            <a asp-controller="Items" asp-action="Insert" class="btn btn-success">+</a>
        }
    </div>
    <div class="card-body p-4">
        <table id="tblData" class="table table-bordered table-striped pt-3" style="width:100%">
            <thead>
                <tr>
                    <th>ID</th>
                    @if (isUberAdmin)
                    {
                        <th>OrganizationId</th>
                    }
                    <th>Label</th>
                    @if (ViewBag.ItemGridColumns != null && ViewBag.ItemGridColumns.Count > 0)
                    {
                        foreach (MainGridColumnDto mgc in ViewBag.ItemGridColumns)
                        {
                            <th>@mgc.Label</th>
                        }
                    }
                    <th>Tags</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Bootstrap Modal for delete -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this item?
            </div>
            <div class="modal-footer">
                <form method="get" id="deleteForm" action="/Items/Delete">
                    <input type="hidden" name="id" id="deleteId" />
                    <input type="hidden" name="status" value="@status" />
                    <button type="submit" class="btn btn-primary">OK</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap Modal for undelete -->
<div class="modal fade" id="confirmUndeleteModal" tabindex="-1" aria-labelledby="confirmUndeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmUndeleteModalLabel">Confirm Undelete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to undelete this item?
            </div>
            <div class="modal-footer">
                <form method="get" id="undeleteForm" action="/Items/Undelete">
                    <input type="hidden" name="id" id="undeleteId" />
                    <input type="hidden" name="status" value="@status" />
                    <button type="submit" class="btn btn-primary">OK</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap Modal for statusReset -->
<div class="modal fade" id="confirmStatusResetModal" tabindex="-1" aria-labelledby="confirmStatusResetModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmStatusResetModalLabel">Confirm Status reset</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to reset status of this item?
            </div>
            <div class="modal-footer">
                <form method="get" id="statusResetForm" action="/Items/MarkAsNew">
                    <input type="hidden" name="id" id="statusResetId" />
                    <input type="hidden" name="status" value="@status" />
                    <button type="submit" class="btn btn-primary">OK</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Bootstrap Modal for readonly -->
<div class="modal fade" id="confirmReadonlyModal" tabindex="-1" aria-labelledby="confirmReadonlyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-80">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmReadonlyModalLabel">Confirm Readonly</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to readonly this item?
            </div>
            <div class="modal-footer d-flex">
                <form method="get" id="readonlyForm" action="/Items/ReadonlyState" class="d-flex gap-2">
                    <input type="hidden" name="id" id="readonlyId" />
                    <input type="hidden" name="status" value="@status" />
                    <button type="submit" name="variant" value="asIs" class="btn btn-primary">OK (leave device as is)</button>
                    <button type="submit" name="variant" value="removeDevice" class="btn btn-primary">OK (remove device)</button>
                </form>
                <button type="button" class="btn btn-secondary ms-auto" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <!-- colResizable plugin (adds user column resize handles) -->
    <script src="https://cdn.jsdelivr.net/gh/alvaro-prieto/colResizable/colResizable-1.6.min.js"></script>

    <script>
        $(document).ready(function () {
            const params = new URLSearchParams(window.location.search);
            const status = params.get("status") || "new";
            LoadDataTable(status);
        });

        // helper to (re)apply column resizing
        function applyColumnResizing() {
            try {
                // if already initialized, disable first to avoid duplicate handles
                if ($('#tblData').data('colResizable')) {
                    $('#tblData').colResizable({ disable: true });
                }
            } catch (e) {
                // ignore if plugin not initialized yet
            }

            // initialize colResizable
            try {
                $('#tblData').colResizable({
                    liveDrag: true,
                    minWidth: 30,
                    gripInnerHtml: "<div class='grip'></div>",
                    draggingClass: "dragging",
                    partialRefresh: true
                });
            } catch (e) {
                console.warn("colResizable init failed:", e);
            }
        }

        function LoadDataTable(status) {
            dataTable = $('#tblData').DataTable({
                processing: true,
                serverSide: true,
                autoWidth: false,
                ajax: {
                    url: "/Items/GetAll",
                    type: 'POST',
                    data: function (d) {
                        d.statusFilter = status;
                        return d;
                    }
                },
                columns: [
                    // {
                    //     data: 'ImgUrl',
                    //     render: function (data) {
                    //         return `<img src="${data}" class="card-img-top">`;
                    //     },
                    //     width: "2%"
                    // },
                    { data: 'Id', width: '55px' },
                    @if (isUberAdmin)
                    {
                        <text>
                            { data: 'OrganizationId', width: '55px' },
                        </text>
                    }
                    { data: 'Device.Label', width: '155px' },
                    @if (ViewBag.ItemGridColumns != null && ViewBag.ItemGridColumns.Count > 0)
                    {
                        foreach (MainGridColumnDto mgc in ViewBag.ItemGridColumns)
                        {
                            <text>
                            {
                                data: null,
                                render: (data, type, row, meta) => {
                                    var obj = null;
                                    try {
                                        if ("@mgc.Prefix" == "Item")
                                            obj = JSON.parse(data.ItemDataJson);
                                        else if("@mgc.Prefix" == "Device")
                                            obj = data.DeviceDataJson ? JSON.parse(data.DeviceDataJson) : {};
                                        return obj?.["@mgc.Name"] ?? "";
                                    } catch (e) {
                                        return "";
                                    }
                                }
                            },
                            </text>
                        }
                    }
                    {
                        data: 'Tags',
                        render: function (data) {
                            return data.join(", ");
                        },
                        width: '100px'
                    },
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            const openDiv = `<div class="w-75 btn-group" role="group">`;
                            const closeDiv = `</div>`;
                            const infoC = `btn-info`;
                            const succC = `btn-success`;
                            const dangC = `btn-danger`;
                            const grayC = `btn-secondary`;
                            const editUrl = `/Items/Update?id=${data.Id}`;
                            const editInner = `<i class="bi bi-pencil"></i>`;
                            const viewUrl = `/Items/View?id=${data.Id}`;
                            const viewInner = `<i class="bi bi-search"></i>`;
                            const delUrl = `#`;
                            const delInner = `<i class="bi bi-trash"></i>`;
                            const delRC = dangC + ` delete-button`;
                            const delRA = `data-item-id="${data.Id}"`;
                            const undUrl = `#`;
                            const undInner = `<i class="bi bi-arrow-counterclockwise"></i>`;
                            const undRC = infoC + ` undelete-button`;
                            const undRA = `data-item-id="${data.Id}"`;
                            const forwardUrl = `/Items/ForwardState?id=${data.Id}&status=@status`;
                            const finishUrl = `/Items/FinishState?id=${data.Id}`;
                            const forwardInner = `<i class="bi">&gt;</i>`;
                            const readonlyUrl = `#`;
                            const readonlyInner = `<i class="bi bi-lock"></i>`;
                            const readonlyRC = grayC + ` readonly-button`;
                            const readonlyRA = `data-item-id="${data.Id}"`;
                            const statusResetUrl = `#`;
                            const statusResetInner = `<i class="bi">&lt;</i>`;
                            const statusResetRC = infoC + ` resetStatus-button`;
                            const statusResetRA = `data-item-id="${data.Id}"`;


                            switch (data.Status) {
                                case 0x01: // new
                                    return openDiv +
                                        CreateButton(editUrl, editInner, true, false, succC, null) +
                                        CreateButton(delUrl, delInner, false, false, delRC, delRA) +
                                        CreateButton(readonlyUrl, readonlyInner, false, false, readonlyRC, readonlyRA) +
                                        CreateButton(finishUrl, forwardInner, false, true, infoC, null) +
                                        closeDiv;
                                case 0x02: // exported
                                    return openDiv +
                                        CreateButton(statusResetUrl, statusResetInner, true, false, statusResetRC, statusResetRA) +
                                        CreateButton(viewUrl, viewInner, false, false, succC, null) +
                                        CreateButton(readonlyUrl, readonlyInner, false, true, readonlyRC, readonlyRA) +
                                        closeDiv;
                                case 0x04: // imported
                                    return openDiv +
                                        CreateButton(statusResetUrl, statusResetInner, true, false, statusResetRC, statusResetRA) +
                                        CreateButton(viewUrl, viewInner, false, false, succC, null) +
                                        CreateButton(readonlyUrl, readonlyInner, false, false, readonlyRC, readonlyRA) +
                                        CreateButton(forwardUrl, forwardInner, false, true, infoC, null) +
                                        closeDiv;
                                case 0x08: // finished
                                    return openDiv +
                                        CreateButton(statusResetUrl, statusResetInner, true, false, statusResetRC, statusResetRA) +
                                        CreateButton(viewUrl, viewInner, false, true, succC, null) +
                                        closeDiv;
                                case 0x10: // readonly
                                    return openDiv +
                                        CreateButton(statusResetUrl, statusResetInner, true, false, statusResetRC, statusResetRA) +
                                        CreateButton(viewUrl, viewInner, false, true, succC, null) +
                                        closeDiv;
                                case 0x80: // deleted
                                    return openDiv +
                                        CreateButton(viewUrl, viewInner, true, false, succC, null) +
                                        CreateButton(undUrl, undInner, false, true, undRC, undRA) +
                                        closeDiv;
                                default:
                                    return ``;
                            }
                        },
                        width: '120px'
                    }
                ],
                initComplete: function (settings, json) {
                    applyColumnResizing();
                },
                drawCallback: function (settings) {
                    applyColumnResizing();
                }
            });
            $('#tblData').on('xhr.dt', function (e, settings, json, xhr) {
                console.log('DataTables AJAX response (xhr.dt):', json);
            });
            $('#tblData').on('click', '.delete-button', function (event) {
                event.preventDefault(); // Prevent the default action of the link
                var itemId = $(this).data('item-id');
                $('#deleteId').val(itemId);
                $('#confirmDeleteModal').modal('show'); // Manually show the modal
            });
            $('#tblData').on('click', '.undelete-button', function (event) {
                event.preventDefault(); // Prevent the default action of the link
                var itemId = $(this).data('item-id');
                $('#undeleteId').val(itemId);
                $('#confirmUndeleteModal').modal('show'); // Manually show the modal
            });
            $('#tblData').on('click', '.resetStatus-button', function (event) {
                event.preventDefault(); // Prevent the default action of the link
                var itemId = $(this).data('item-id');
                $('#statusResetId').val(itemId);
                $('#confirmStatusResetModal').modal('show'); // Manually show the modal
            });
            $('#tblData').on('click', '.readonly-button', function (event) {
                event.preventDefault(); // Prevent the default action of the link
                var itemId = $(this).data('item-id');
                $('#readonlyId').val(itemId);
                $('#confirmReadonlyModal').modal('show'); // Manually show the modal
            });
        }
        function CreateButton(url, inner, roundedStart, roundedEnd, restClasses, restArguments){
            let ret = `<a href="`;
            ret += url;
            ret += `" class="btn mx-0 px-2`;
            if (roundedStart) ret += ` rounded-start-5`;
            if (roundedEnd) ret += ` rounded-end-5`;
            if (restClasses) ret += ` ` + restClasses;
            ret += `"`;
            if (restArguments) ret += ` `+ restArguments;
            ret += `>`;
            ret += inner;
            ret += `</a>`;
            return ret;
        }
    </script>
}