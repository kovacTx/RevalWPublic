@model InnerItemUpsertDto
@{
    ViewData["Title"] = "Delete Item";
}

<style>
    .auto-resize {
        overflow-y: hidden;
        resize: none;
        min-height: 60px;
    }

    .no-wrap {
        white-space: pre; /* preserve spaces and line breaks */
        overflow-x: auto; /* enable horizontal scroll */
        overflow-y: auto; /* vertical scroll if needed */
        resize: both; /* optional: allow resize */
        word-wrap: normal; /* prevent long words from wrapping */
        word-break: keep-all; /* keep text unbroken */
    }
</style>

<div class="container border p-4">
    <form asp-action="Delete" method="post">
        <input asp-for="Id" hidden />
        <div class="form-group">
            <label asp-for="Status" class="control-label" readonly="readonly"></label>
            <input asp-for="Status" class="form-control" />
        </div>
        <div class="border form-group my-2 p-2">
            <h6>For Config types</h6>
            <div id="tags-container" class="d-flex flex-column gap-2">
                @if (Model?.Tags?.Any() == true)
                {
                    for (int i = 0; i < Model.Tags.Count; i++)
                    {
                        var tn = Model.Tags[i];
                        if (string.IsNullOrEmpty(tn)) continue;
                        <div class="d-flex align-items-center gap-2 input-row">
                            <input class="form-control flex-grow-1" value="@tn" readonly="readonly" />
                        </div>
                    }
                }
            </div>
        </div>
        <div class="form-group">
            <label asp-for="ItemDataJson" class="control-label">Input Data</label>
            <textarea asp-for="ItemDataJson" class="form-control w-100 auto-resize no-wrap font-monospace" rows="5" readonly="readonly"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="AppDataJson" class="control-label">Application Data</label>
            <textarea asp-for="AppDataJson" class="form-control w-100 auto-resize no-wrap font-monospace" rows="5" readonly="readonly"></textarea>
        </div>

        <div class="form-group d-flex align-items-center mt-2">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('input', function (event) {
            const target = event.target;
            if (target && target.matches && target.matches('.auto-resize')) {
                event.target.style.height = 'auto';
                event.target.style.height = event.target.scrollHeight + 'px';
            }
        });
    </script>
}
