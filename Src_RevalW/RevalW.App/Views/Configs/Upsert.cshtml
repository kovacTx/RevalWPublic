@using System.Linq
@using RevalW.Shared.Model
@using RevalW.Shared.Utils
@model InnerConfigUpsertDto
@{
    if (Model?.Id > 0)
    {
        ViewData["Title"] = "Update Config";
    }
    else
    {
        ViewData["Title"] = "Create Config";
    }
}

<style>
    .modal-90w {
        max-width: 90% !important;
    }

    .monaco-container {
        border: 1px solid #343a40; /* darker border for dark theme */
        border-radius: .25rem;
        overflow: hidden;
        background: #1e1e1e; /* fallback background for dark theme */
    }

    /* resizable wrapper and handle */
    .resizable-editor {
        position: relative;
        display: block;
    }

    /* corner resizer: small square in lower-right corner */
    .resizer {
        width: 12px;
        height: 12px;
        position: absolute;
        right: 6px;
        bottom: 6px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 2px;
        cursor: se-resize;
        z-index: 20;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
    }

    /* increase effective touch/click area without changing visual size */
    .resizer::after {
        content: '';
        position: absolute;
        left: -8px;
        top: -8px;
        right: -8px;
        bottom: -8px;
    }

    .resizer:hover {
        background: rgba(255,255,255,0.10);
        box-shadow: 0 0 6px rgba(0,0,0,0.25) inset;
    }

    /* ensure Monaco inside modal gets sized properly when wrapper manages height */
    #monaco-DocumentTemplate {
        height: 400px;
    }
</style>

<form asp-action="Upsert" enctype="multipart/form-data" id="UpsertForm">
    <div class="container border p-4">
        <div class="row">
            <div class="row text-center p-3">
                @if (Model?.Id > 0)
                {
                    <h1>Update Config</h1>
                }
                else
                {
                    <h1>Create Config</h1>
                }
                <input asp-for="Id" hidden />
                <input asp-for="OrganizationId" hidden />
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (User?.Identity?.IsAuthenticated == true && User?.IsInRole(ERoles.UberAdmin) == true)
            {
                <div class="d-flex align-items-center input-row pb-3">
                    <div class="me-1">
                        <div class="d-flex input-row">
                            <label class="me-1">
                                <input type="checkbox" asp-for="UpdateWDll" />
                                update W dll
                            </label>
                            <input asp-for="WDllLastUpdated" disabled />
                        </div>
                        <input asp-for="WDll" accept=".dll" class="form-control" />
                    </div>
                    <div class="me-1">
                        <div class="d-flex input-row">
                            <label class="me-1">
                                <input type="checkbox" asp-for="UpdateADll" />
                                update A dll
                            </label>
                            <input asp-for="ADllLastUpdated" disabled />
                        </div>
                        <input asp-for="ADll" accept=".dll" class="form-control" />
                    </div>
                    <div>
                        <div class="d-flex input-row">
                            <label>
                                <input type="checkbox" asp-for="UpdateIDll" />
                                update I dll
                            </label>
                            <input asp-for="IDllLastUpdated" disabled />
                        </div>
                        <input asp-for="IDll" accept=".dll" class="form-control" />
                    </div>
                </div>
            }
            <div class="col-10 pb-3 w-100">
                @if (User?.Identity?.IsAuthenticated == true && User?.IsInRole(ERoles.UberAdmin) == true)
                {
                    <div class="col-10 w-100 input-row">
                        <label>
                            <input type="checkbox" asp-for="UpdateImage" />
                            update image
                        </label>
                    </div>

                }
                <img src="@Model?.ImageUrl" class="card-img-top" style="width: 200px">
                <input asp-for="Image" accept=".jpg,.png" class="form-control" />
                <input asp-for="ImageUrl" hidden class="form-control" />
            </div>
            <div class="col-12 col-6 pb-2">
                <label asp-for="Version" class="control-label"></label>
                <input asp-for="Version" class="form-control" />
                <span asp-validation-for="Version" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Designation" class="control-label"></label>
                <input asp-for="Designation" class="form-control" />
                <span asp-validation-for="Designation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Author" class="control-label"></label>
                <input asp-for="Author" class="form-control" />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>
            <div class="border form-group my-2 p-2">
                <h6>Tags</h6>
                <div id="TagsContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="text" class="form-control flex-grow-1 mt-2" id="Tag"
                           placeholder="Enter Tag..." />
                </div>
                <button type="button" id="AddTagBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="TagsJson" />
                <span id="Tags-error" class="text-danger"></span>
            </div>
            <div class="border form-group my-2 p-2">
                <h6>New Item Properties</h6>
                <div id="NewItemPropertiesContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <button type="button" id="NewItemPropertyAddBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="NewItemPropertiesJson" />
            </div>
            <div class="border form-group my-2 p-2">
                <h6>Printable Documents</h6>
                <label>
                    <input type="checkbox" asp-for="CanSelectMoreDocuments" />
                    can select more
                </label>
                <div id="PrintableDocumentsContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <button type="button" id="PrintableDocumentAddBtn" class="btn btn-primary mt-2 col-2" data-bs-toggle="modal" data-bs-target="#PrintableDocumentModal">+</button>
                <input type="hidden" asp-for="PrintableDocumentsJson" />

                <h6 class="mt-2">Resources</h6>
                <div id="DocumentsResourcesContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <div class="col-10 pb-3 w-100">
                    <div id="DocumentsResourcesWrapper">
                        <input id="DocumentsResourcesSelector" type="file" class="form-control mb-2 file-input" />
                    </div>
                </div>
                <input type="hidden" asp-for="OldDocumentsResourcesJson" />
            </div>

            <div class="form-group">
                <label asp-for="Content" class="control-label"></label>

                <!-- resizable wrapper for main Monaco editor; initial height 600px preserved -->
                <div class="resizable-editor">
                    <div id="monaco-ConfigContent" class="monaco-container w-100" style="height:600px;"></div>
                    <div id="monaco-ConfigContent-resizer" class="resizer" data-initial-height="600" title="Drag lower-right corner to resize editor"></div>
                </div>

                <textarea asp-for="Content" id="ConfigContentHidden" class="d-none"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- Modal -->
            <div class="modal fade" id="PrintableDocumentModal" tabindex="-1"
                 data-bs-backdrop="static" data-bs-keyboard="false"
                 aria-labelledby="PrintableDocumentModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-90w">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="PrintableDocumentModalLabel">Add Printable Document</h5>
                            <input id="DocumentId" hidden />
                        </div>
                        <div class="modal-body">
                            <div class="form-group">
                                <label for="documentLabel" class="control-label">Label</label>
                                <input type="text" class="form-control" id="DocumentLabel">
                                <span id="DocumentName-error" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="documentEnabled" class="control-label">Enabled</label>
                                <input type="text" class="form-control" id="DocumentEnabled">
                            </div>
                            <label>
                                <input type="checkbox" id="AlwaysTrue" />
                                always generate
                            </label>
                            <div class="form-group">
                                <label for="documentRestParams" class="control-label">Rest params</label>
                                <input type="text" class="form-control" id="DocumentRestParams">
                                <span id="DocumentRestParams-error" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="documentTemplate" class="control-label">Template</label>

                                <!-- resizable wrapper for modal editor; initial height 400px preserved -->
                                <div class="resizable-editor">
                                    <div id="monaco-DocumentContent" class="monaco-container w-100" style="height:400px;"></div>
                                    <div id="monaco-DocumentContent-resizer" class="resizer" data-initial-height="400" title="Drag lower-right corner to resize template editor"></div>
                                </div>

                                <textarea class="form-control d-none" id="DocumentTemplateHidden" rows="30"></textarea>

                                <span id="DocumentTemplate-error" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-footer row mx-1 mb-1">
                            <button type="button" class="btn btn-primary col-6 col-md-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-success col-6 col-md-3 offset-md-6" id="AddPrintableDocument">OK</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer row mx-0">
                <div class="col-6 col-md-3">
                    <a asp-action="ConfigsIndex" class="btn btn-primary form-control">Back to List</a>
                </div>
                <div class="col-6 col-md-3 offset-md-6">
                    @if (Model?.Id > 0)
                    {
                        <input type="submit" value="Update" class="btn btn-success form-control" />
                    }
                    else
                    {
                        <input type="submit" value="Create" class="btn btn-success form-control" />
                    }
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Modal -->
<div class="modal fade" id="DynamicPropertyModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false"
     aria-labelledby="DynamicPropertyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-90w">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DynamicPropertyModalLabel">Add dynamic property</h5>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="propName" class="control-label">Name</label>
                    <input type="text" class="form-control" id="PropName">
                    <span id="Name-error" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="propLabel" class="control-label">Label</label>
                    <input type="text" class="form-control" id="PropLabel">
                </div>
                <div class="form-group">
                    <label class="control-label" for="PropRequired">
                        <input type="checkbox" id="PropRequired">
                        Required
                    </label>
                </div>
                <div class="form-group">
                    <label class="control-label" for="PropReadonly">
                        <input type="checkbox" id="PropReadonly">
                        Read only
                    </label>
                </div>
                <div class="form-group">
                    <label for="propInputType" class="control-label">Input Type</label>
                    <select class="form-control" id="PropInputType">
                        <option value="text" selected>Text</option>
                        <option value="number">Number</option>
                        <option value="date">Date</option>
                        <option value="time">Time</option>
                        <option value="comboBox">ComboBox</option>
                        <option value="email">Email</option>
                        <option value="password">Password</option>
                        <option value="tel">Telephone</option>
                        <option value="checkbox">Checkbox</option>
                    </select>
                </div>
                <div class="form-group number-dependent">
                    <label for="propMin" class="control-label">Minimal value</label>
                    <input type="number" class="form-control" id="PropMin">
                </div>
                <div class="form-group number-dependent">
                    <label for="propMax" class="control-label">Maximum value</label>
                    <input type="number" class="form-control" id="PropMax">
                </div>
                <div class="form-group number-dependent">
                    <label for="propStep" class="control-label">Step</label>
                    <input type="number" class="form-control" id="PropStep">
                </div>
                <div class="form-group combobox-dependent">
                    <label for="propComboOptions" class="control-label">Options (comma separated)</label>
                    <input type="text" class="form-control" id="PropComboOptions">
                </div>
                <div class="form-group">
                    <label for="propDefault" class="control-label">Default value</label>
                    <input type="text" class="form-control" id="PropDefault">
                </div>
            </div>
            <div class="card-footer row mx-1 mb-1">
                <button type="button" class="btn btn-primary col-6 col-md-3" id="CancelAddDynamicProperty" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success col-6 col-md-3 offset-md-6" id="AddDynamicProperty">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/valueInserter.js"></script>
    <script src="~/js/monacoArea.js"></script>
    <script src="~/js/dynamicPropertyInserter.js"></script>

    <script src="~/js/printableDocumentUpsert.js"></script>
    <script src="~/js/documentsResourcesInsert.js"></script>

    <script src="~/js/configContentInit.js"></script>
    <script src="~/js/documentContentInit.js"></script>
    <script>
        const tagInserter = new ValueInserter();
        const newItemPropertyInserter = new DynamicPropertyInserter();

        document.addEventListener('DOMContentLoaded', function () {
            $('#AddTagBtn').on('click', addTag);
            $('#UpsertForm').on('submit', addTag);
            $('#UpsertForm').on('submit', onFormSubmit);

            tagInserter.clearValueFunc = () => $('#Tag').val('');
            tagInserter.isEmpty = (value) => !value;
            tagInserter.compareTo = (value1, value2) => value1 == value2;
            tagInserter.buttonLabelGetterFunc = (value) => value;
            tagInserter.$valuesJsonHolder = $('#TagsJson');
            tagInserter.$valueElementsContainer = $('#TagsContainer');
            tagInserter.createNewValueElementFunc = (value) => tagInserter.createRemovableNewValueElement(value);
            tagInserter.init();

            newItemPropertyInserter.$dynamicPropertyInsertBtn = $('#NewItemPropertyAddBtn');
            newItemPropertyInserter.$valuesJsonHolder = $('#NewItemPropertiesJson');
            newItemPropertyInserter.$valueElementsContainer = $('#NewItemPropertiesContainer');
            newItemPropertyInserter.$addDynamicPropertyBtn = $('#AddDynamicProperty');
            newItemPropertyInserter.$cancelAddDynamicPropertyBtn = $('#CancelAddDynamicProperty');
            newItemPropertyInserter.init();
        });
        function addTag() {
            tagInserter.addValue($('#Tag').val());
        }
        function onFormSubmit(event){
            $('#Tags-error').text('');
            let tags = '';
            if ($('#TagsJson').val()) tags = JSON.parse($('#TagsJson').val());
            if (!tags || tags.length === 0) {
                $('#Tags-error').text('no tags?');
                event.preventDefault();
            }
        }
    </script>
}