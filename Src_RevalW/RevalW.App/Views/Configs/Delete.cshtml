@model InnerConfigUpsertDto

<style>
    .auto-resize {
        overflow-y: hidden;
        resize: none;
        min-height: 60px;
    }

    .no-wrap {
        white-space: pre; /* preserve spaces and line breaks */
        overflow-x: auto; /* enable horizontal scroll */
        overflow-y: auto; /* vertical scroll if needed */
        resize: both; /* optional: allow resize */
        word-wrap: normal; /* prevent long words from wrapping */
        word-break: keep-all; /* keep text unbroken */
    }
</style>

<div class="container border p-4">
    <form asp-action="Delete" method="post">
        <div class="row text-center p-3">
            <h1>Create Config</h1>
            <input asp-for="Id" hidden />
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-10 pb-3">
            <input asp-for="Image" class="form-control" />
            <input asp-for="ImageUrl" hidden class="form-control" />
        </div>
        <div class="col-12 col-6 pb-2">
            <label asp-for="Version" class="control-label"></label>
            <input asp-for="Version" class="form-control" readonly="readonly" />
        </div>
        <div class="form-group">
            <label asp-for="Designation" class="control-label"></label>
            <input asp-for="Designation" class="form-control" readonly="readonly" />
        </div>
        <div class="form-group">
            <label asp-for="Author" class="control-label"></label>
            <input asp-for="Author" class="form-control" readonly="readonly" />
        </div>
        <div class="border form-group my-2 p-2">
            <h6>For Config types</h6>
            <div id="tags-container" class="d-flex flex-column gap-2">
                @if (ViewBag.Tags != null && ViewBag.Tags.Count > 0)
                {
                    for (int i = 0; i < ViewBag.Tags.Count; i++)
                    {
                        var tn = ViewBag.Tags[i];
                        if (string.IsNullOrEmpty(tn)) continue;
                        <div class="d-flex align-items-center gap-2 input-row">
                            <input type="text" name="Tags[@i]" value="@tn" class="form-control flex-grow-1" placeholder="Enter Tag..." readonly="readonly" />
                        </div>
                    }
                }
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Content" class="control-label"></label>
            <textarea asp-for="Content" class="form-control w-100 auto-resize no-wrap font-monospace" rows="5" readonly="readonly"></textarea>
        </div>

        <div class="form-group d-flex align-items-center mt-2">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('input', function (event) {
            const target = event.target;
            if (target && target.matches && target.matches('.auto-resize')) {
                event.target.style.height = 'auto';
                event.target.style.height = event.target.scrollHeight + 'px';
            }
        });
    </script>
}
