@using RevalW.App.Model
@using RevalW.Shared.Model
@using RevalW.Shared.Utils
@model InnerRegistrationRequestDto
@{
    var userValues = ViewBag.UserValues as Dictionary<string, string>;
}

<div class="container border p-4">
    <form asp-action="Register" method="post" id="RegisterForm">
        <div class="row text-center p-3">
            <h1>Register</h1>
        </div>
        <div class="row">
            @if (User?.Identity?.IsAuthenticated != true)
            {
                <div class="border col-12 col-6 mb-1 pb-1 ">
                    <h6>Organization</h6>
                    <div class="col-12 col-6 pb-2">
                        <input asp-for="OrganizationName" class="form-control" placeholder="organization name.." />
                        <span asp-validation-for="OrganizationName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-6 pb-2">
                        <input asp-for="OrganizationDescription" class="form-control" placeholder="organization description.." />
                        <span asp-validation-for="OrganizationDescription" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-6 pb-2">
                        <input asp-for="OrganizationStreet" class="form-control" placeholder="Street" />
                        <span asp-validation-for="OrganizationStreet" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-6 pb-2">
                        <input asp-for="OrganizationZip" class="form-control" placeholder="ZIP" />
                        <span asp-validation-for="OrganizationZip" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-6 pb-2">
                        <input asp-for="OrganizationCity" class="form-control" placeholder="City" />
                        <span asp-validation-for="OrganizationCity" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-6 pb-2">
                        <input asp-for="OrganizationCountryRegion" class="form-control" placeholder="Country/region" />
                        <span asp-validation-for="OrganizationCountryRegion" class="text-danger"></span>
                    </div>
                </div>
            }
            <div class="col-12 col-6 pb-2">
                <input asp-for="Email" class="form-control" placeholder="email.." />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <input asp-for="Name" class="form-control" placeholder="name.." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <input asp-for="PhoneNumber" class="form-control" placeholder="phone number.." />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <div class="d-flex align-items-center">
                    <input asp-for="Password" class="form-control me-2" placeholder="password.." type="password" id="PasswordInput" />
                    <label class="form-check form-check-inline mb-0" style="white-space: nowrap;">
                        <input class="form-check-input" type="checkbox" id="ShowPasswordCheckbox" />
                        Show password
                    </label>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <input asp-for="Password2" class="form-control" placeholder="password.." type="password" />
                <span asp-validation-for="Password2" class="text-danger"></span>
            </div>
            @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole(ERoles.Creator) || User.IsInRole(ERoles.UberAdmin)))
            {
                <div class="border col-12 col-6 mb-1 pb-1 ">
                    <h6>Roles</h6>
                    @foreach (var role in ViewBag.Roles)
                    {
                        <label class="me-2">
                            <input type="checkbox" name="selectedRoles" value="@role.Name" @(role.Selected ? "checked" : "") />
                            @role.Name
                        </label>
                    }
                </div>
            }
        </div>
        <input type="hidden" id="NewUserPropertiesJson" asp-for="UserDataJson" />
    </form>
    @if (ViewBag.NewUserProperties != null && ViewBag.NewUserProperties.Count > 0)
    {
        <div class="row">
            <div class="border form-group my-2 p-2" id="NewUserPropertiesHolder">
                <h6>Properties</h6>
                @foreach (DynamicPropertyDto dp in ViewBag.NewUserProperties)
                {
                    <div class="form-group">
                        <label class="control-label" for="@dp.Name">@dp.Label</label>
                        @if (dp.InputType == "comboBox")
                        {
                            <select class="form-control dynamic-property" data-property-name="@dp.Name" data-property-label="@dp.Label"
                                    @(dp.Required ? "required" : null) @(dp.Readonly ? "readonly" : null)>
                                <option value="" selected disabled>-- Select --</option>
                                @foreach (var option in dp.ComboOptions?.Split(",") ?? ["none options provided"])
                                {
                                    var selected = userValues != null && userValues.ContainsKey(dp.Name)
                                    ? userValues[dp.Name] == option
                                    : option == dp.Default;
                                    <option value="@option" selected="@selected">@option</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input class="form-control dynamic-property" data-property-name="@dp.Name" data-property-label="@dp.Label"
                                   type="@dp.InputType" max="@dp.Max" min="@dp.Min" step="@dp.Step"
                                   value="@(userValues is not null && userValues.ContainsKey(dp.Name) ? userValues[dp.Name] : dp.Default)"
                                   required=@(dp.Required) readonly=@(dp.Readonly) />
                        }
                        <span id="@($"{dp.Name}-error")" class="text-danger"></span>
                    </div>
                }
            </div>
        </div>
    }
</div>
<div class="col-12 col-6 pb-2">
    <button type="button" value="Register" class="btn btn-success form-control" id="RegisterButton">Register</button>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dynamicPropertiesApplier.js"></script>
    <script>
        const dynamicPropertyApplier = new DynamicPropertiesApplier();
        document.addEventListener("DOMContentLoaded", function () {
            dynamicPropertyApplier.$appliedProperties = $('#NewUserPropertiesJson');
            dynamicPropertyApplier.$propertiesHolder = $('#NewUserPropertiesHolder');

            $('#RegisterButton').on('click', function () {
                $('#RegisterForm').submit();
            });
            const $passwordInput = $("#PasswordInput");
            const $toggle = $("#ShowPasswordCheckbox");

            $toggle.on("change", function () {
                if ($(this).is(":checked")) {
                    $passwordInput.attr("type", "text");
                } else {
                    $passwordInput.attr("type", "password");
                }
            });
            $('#RegisterForm').on('submit', onFormSubmit);
        });

        function onFormSubmit(event) {
            dynamicPropertyApplier.applyDynamicProperties(event);
        }
    </script>
}