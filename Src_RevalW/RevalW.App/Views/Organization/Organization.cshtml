@using System.Linq
@using System.Text.Json
@using RevalW.Shared.Model
@using RevalW.Shared.Utils
@model InnerOrganizationUpdateDto
@{
    ViewData["Title"] = "Update Organization";
    var tags = ViewBag.AvailableTags as IEnumerable<string> ?? [];
    var allPermissions = ViewBag.AllPermissions as Dictionary<string, string> ?? [];
}

<style>
    .modal-90w {
        max-width: 90% !important;
    }
</style>

<form asp-action="OrganizationUpdate" id="OrganizationUpdateForm">
    <div class="container border p-4">
        <div class="row">
            <div class="row text-center p-3">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1 text-center">
                        <h1 class="m-0">Update Organization</h1>
                    </div>
                    <a class="btn btn-primary ms-3" asp-controller="Users" asp-action="UserIndex">
                        Users
                    </a>
                </div>
                <input asp-for="Id" hidden />
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-12 col-6 pb-2">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" readonly />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="border form-group my-2 p-2">
                <h6>Tags</h6>
                <div id="TagsContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <input list="tags" class="form-control flex-grow-1 mt-2" id="TagInput"
                       placeholder="Enter Tag..." />
                <datalist id="tags">
                    @foreach (var name in tags)
                    {
                        <option value="@name">@name</option>
                    }
                </datalist>
                <button type="button" id="AddTagBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="TagsJson" />
            </div>
            <div class="col-12 col-6 pb-2">
                <label asp-for="Street" class="control-label"></label>
                <input asp-for="Street" class="form-control" />
                <span asp-validation-for="Street" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <label asp-for="Zip" class="control-label"></label>
                <input asp-for="Zip" class="form-control" />
                <span asp-validation-for="Zip" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <label asp-for="City" class="control-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="col-12 col-6 pb-2">
                <label asp-for="CountryRegion" class="control-label">Country / Region</label>
                <input asp-for="CountryRegion" class="form-control" readonly />
                <span asp-validation-for="CountryRegion" class="text-danger"></span>
            </div>
            <div class="border form-group my-2 p-2">
                <h6>New User Properties</h6>
                <div id="NewUserPropertiesContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <button type="button" id="NewUserPropertyAddBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="NewUserPropertiesJson" />
            </div>
            <div class="border form-group my-2 p-2">
                <h6>Roles</h6>
                <div id="RolesContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <button type="button" id="RoleAddBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="RolesJson" />
            </div>
            <div class="border form-group my-2 p-2">
                <h6>New Item Properties</h6>
                <div id="NewItemPropertiesContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <button type="button" id="NewItemPropertyAddBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="NewItemPropertiesJson" />
            </div>
            <div class="border form-group my-2 p-2">
                <h6>New Device Properties</h6>
                <div id="NewDevicePropertiesContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <button type="button" id="NewDevicePropertyAddBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="NewDevicePropertiesJson" />
            </div>
            <div class="border form-group my-2 p-2">
                <h6>Items tab columns</h6>
                <div id="ItemColumnsContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <select class="form-select mt-2" id="ItemColumnSelect">
                    <option value="" selected disabled>-- Select a value --</option>
                    @if (ViewBag.AvailableItemGridColumns != null && ViewBag.AvailableItemGridColumns.Count > 0)
                    {
                        @foreach (MainGridColumnDto mgc in ViewBag.AvailableItemGridColumns)
                        {
                            <option data-value="@JsonSerializer.Serialize(mgc)">@mgc.Label</option>
                        }
                    }
                </select>
                <button type="button" id="AddItemColumnBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" id="MergedPropertiesJson" />
                <input type="hidden" asp-for="ItemGridColumnsJson" />
            </div>
            <div class="border form-group my-2 p-2">
                <h6>Devices tab columns</h6>
                <div id="DeviceColumnsContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                </div>
                <select class="form-select mt-2" id="DeviceColumnSelect">
                    <option value="" selected disabled>-- Select a value --</option>
                    @if (ViewBag.AvailableDeviceGridColumns != null && ViewBag.AvailableDeviceGridColumns.Count > 0)
                    {
                        @foreach (MainGridColumnDto mgc in ViewBag.AvailableDeviceGridColumns)
                        {
                            <option data-value="@JsonSerializer.Serialize(mgc)">@mgc.Label</option>
                        }
                    }
                </select>
                <button type="button" id="AddDeviceColumnBtn" class="btn btn-primary mt-2 col-2">+</button>
                <input type="hidden" asp-for="DeviceGridColumnsJson" />
            </div>
            @if (User?.Identity?.IsAuthenticated == true && User?.IsInRole(ERoles.UberAdmin) == true)
            {
                <div class="border form-group my-2 p-2">
                    <h6>configs</h6>
                    <div id="ConfigsContainer" class="d-flex flex-row flex-wrap gap-2 align-items-start">
                        @if (ViewBag.Configs != null && ViewBag.Configs.Count > 0)
                        {
                            for (int i = 0; i < ViewBag.Configs.Count; i++)
                            {
                                ConfigHeaderDto config = ViewBag.Configs[i];
                                <div class="d-flex align-items-center input-row">
                                    <a asp-controller="Configs" asp-action="Update" asp-route-id="@config.Id" class="btn btn-primary form-control">
                                        @config.Id - @config.Designation (@string.Join(", ", config.Tags))
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <div class="card-footer row mx-0">
                <div class="col-6 col-md-3">
                    <a href="/" class="btn btn-primary form-control">Back</a>
                </div>
                <div class="col-6 col-md-3 offset-md-6">
                    <input type="submit" value="Update" class="btn btn-success form-control" />
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Modal -->
<div class="modal fade" id="DynamicPropertyModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false"
     aria-labelledby="DynamicPropertyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-90w">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DynamicPropertyModalLabel">Add dynamic property</h5>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="propName" class="control-label">Name</label>
                    <input type="text" class="form-control" id="PropName">
                    <span id="Name-error" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label for="propLabel" class="control-label">Label</label>
                    <input type="text" class="form-control" id="PropLabel">
                </div>
                <div class="form-group">
                    <label class="control-label" for="PropRequired">
                        <input type="checkbox" id="PropRequired">
                        Required
                    </label>
                </div>
                <div class="form-group">
                    <label class="control-label" for="PropReadonly">
                        <input type="checkbox" id="PropReadonly">
                        Read only
                    </label>
                </div>
                <div class="form-group">
                    <label for="propInputType" class="control-label">Input Type</label>
                    <select class="form-control" id="PropInputType">
                        <option value="text" selected>Text</option>
                        <option value="number">Number</option>
                        <option value="date">Date</option>
                        <option value="time">Time</option>
                        <option value="comboBox">ComboBox</option>
                        <option value="email">Email</option>
                        <option value="password">Password</option>
                        <option value="tel">Telephone</option>
                        <option value="checkbox">Checkbox</option>
                    </select>
                </div>
                <div class="form-group number-dependent">
                    <label for="propMin" class="control-label">Minimal value</label>
                    <input type="number" class="form-control" id="PropMin">
                </div>
                <div class="form-group number-dependent">
                    <label for="propMax" class="control-label">Maximum value</label>
                    <input type="number" class="form-control" id="PropMax">
                </div>
                <div class="form-group number-dependent">
                    <label for="propStep" class="control-label">Step</label>
                    <input type="number" class="form-control" id="PropStep">
                </div>
                <div class="form-group combobox-dependent">
                    <label for="propComboOptions" class="control-label">Options (comma separated)</label>
                    <input type="text" class="form-control" id="PropComboOptions">
                </div>
                <div class="form-group">
                    <label for="propDefault" class="control-label">Default value</label>
                    <input type="text" class="form-control" id="PropDefault">
                </div>
            </div>
            <div class="card-footer row mx-1 mb-1">
                <button type="button" class="btn btn-primary col-6 col-md-3" id="CancelAddDynamicProperty" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success col-6 col-md-3 offset-md-6" id="AddDynamicProperty">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="RoleModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false"
     aria-labelledby="RoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-90w">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="RoleModalLabel">Add role</h5>
            </div>
            <div class="modal-body" id="roleModalBody">
                <div class="form-group">
                    <label for="roleName" class="control-label">Role name</label>
                    <input type="text" class="form-control" id="roleName">
                    <span id="Role-Name-error" class="text-danger"></span>
                </div>

                <div id="RolePermissionsContainer" class="d-flex flex-column gap-2 mt-3">
                </div>
            </div>
            <div class="card-footer row mx-1 mb-1">
                <button type="button" class="btn btn-primary col-6 col-md-3" id="CancelAddRole" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success col-6 col-md-3 offset-md-6" id="AddRole">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/valueInserter.js"></script>
    <script src="~/js/dynamicPropertyInserter.js"></script>
    <script src="~/js/roleInserter.js"></script>
    <script src="~/js/mainGridColumnsInserter.js"></script>

    <script src="~/js/organizationTagsInsert.js"></script>
    <script>
        const newDevicePropertyInserter = new DynamicPropertyInserter();
        const newItemPropertyInserter = new DynamicPropertyInserter();
        const newUserPropertyInserter = new DynamicPropertyInserter();
        const newRoleInserter = new RoleInserter();
        const itemGridColumnsInserter = new MainGridColumnsInserter();
        const deviceGridColumnsInserter = new MainGridColumnsInserter();

        document.addEventListener('DOMContentLoaded', function (event) {

            newDevicePropertyInserter.$dynamicPropertyInsertBtn = $('#NewDevicePropertyAddBtn');
            newDevicePropertyInserter.$valuesJsonHolder = $('#NewDevicePropertiesJson');
            newDevicePropertyInserter.$valueElementsContainer = $('#NewDevicePropertiesContainer');
            newDevicePropertyInserter.$addDynamicPropertyBtn = $('#AddDynamicProperty');
            newDevicePropertyInserter.$cancelAddDynamicPropertyBtn = $('#CancelAddDynamicProperty');
            newDevicePropertyInserter.init();

            newItemPropertyInserter.$dynamicPropertyInsertBtn = $('#NewItemPropertyAddBtn');
            newItemPropertyInserter.$valuesJsonHolder = $('#NewItemPropertiesJson');
            newItemPropertyInserter.$valueElementsContainer = $('#NewItemPropertiesContainer');
            newItemPropertyInserter.$addDynamicPropertyBtn = $('#AddDynamicProperty');
            newItemPropertyInserter.$cancelAddDynamicPropertyBtn = $('#CancelAddDynamicProperty');
            newItemPropertyInserter.init();

            newUserPropertyInserter.$dynamicPropertyInsertBtn = $('#NewUserPropertyAddBtn');
            newUserPropertyInserter.$valuesJsonHolder = $('#NewUserPropertiesJson');
            newUserPropertyInserter.$valueElementsContainer = $('#NewUserPropertiesContainer');
            newUserPropertyInserter.$addDynamicPropertyBtn = $('#AddDynamicProperty');
            newUserPropertyInserter.$cancelAddDynamicPropertyBtn = $('#CancelAddDynamicProperty');
            newUserPropertyInserter.init();

            newRoleInserter.$roleInsertBtn = $('#RoleAddBtn');
            newRoleInserter.$valuesJsonHolder = $('#RolesJson');
            newRoleInserter.$valueElementsContainer = $('#RolesContainer');
            newRoleInserter.$addRoleBtn = $('#AddRole');
            newRoleInserter.$cancelAddRoleBtn = $('#CancelAddRole');
            newRoleInserter.allPermissions = @Html.Raw(JsonSerializer.Serialize(allPermissions));
            newRoleInserter.$modalBody = $('#roleModalBody');
            newRoleInserter.init();

            $('#NewItemPropertiesJson, #NewDevicePropertiesJson').on('change', mergeProps);
            mergeProps();

            itemGridColumnsInserter.columnSelectJquery = $('#ItemColumnSelect');
            itemGridColumnsInserter.$dynamicPropertiesJsonHolder = $('#MergedPropertiesJson');
            itemGridColumnsInserter.$form = $('#OrganizationUpdateForm');
            itemGridColumnsInserter.columnSelectedOptionValueFetcher = () => $('#ItemColumnSelect option:selected').data('value');
            itemGridColumnsInserter.mainGridColumnsJquery = $('#ItemGridColumnsJson');
            itemGridColumnsInserter.columnsContainerJquery = $('#ItemColumnsContainer');
            itemGridColumnsInserter.clearValueFunc = () => $('#ItemColumnSelect').val('');
            itemGridColumnsInserter.addColumnBtnJquery = $('#AddItemColumnBtn');
            itemGridColumnsInserter.init();

            deviceGridColumnsInserter.columnSelectJquery = $('#DeviceColumnSelect');
            deviceGridColumnsInserter.$dynamicPropertiesJsonHolder = $('#NewDevicePropertiesJson');
            deviceGridColumnsInserter.$form = $('#OrganizationUpdateForm');
            deviceGridColumnsInserter.columnSelectedOptionValueFetcher = () => $('#DeviceColumnSelect option:selected').data('value');
            deviceGridColumnsInserter.mainGridColumnsJquery = $('#DeviceGridColumnsJson');
            deviceGridColumnsInserter.columnsContainerJquery = $('#DeviceColumnsContainer');
            deviceGridColumnsInserter.clearValueFunc = () => $('#DeviceColumnSelect').val('');
            deviceGridColumnsInserter.addColumnBtnJquery = $('#AddDeviceColumnBtn');
            deviceGridColumnsInserter.init();
        });

        function mergeProps() {
            var itemVal = $('#NewItemPropertiesJson').val() || '';
            var devVal  = $('#NewDevicePropertiesJson').val() || '';

            var itemArr = itemVal ? JSON.parse(itemVal) : [];
            var devArr  = devVal ? JSON.parse(devVal) : [];

            var prefixedItemProps = itemArr.map(function(x) {
                return { ...x, Prefix: "Item" };
            });
            var prefixedDevProps = devArr.map(function(x) {
                return { ...x, Prefix: "Device" };
            });

            var mergedArr = prefixedItemProps.concat(prefixedDevProps);

            $('#MergedPropertiesJson').val(JSON.stringify(mergedArr)).trigger('change');
        }

    </script>
}