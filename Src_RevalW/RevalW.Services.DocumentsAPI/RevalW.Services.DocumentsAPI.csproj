<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="Dubacik22.ErrorResult" Version="1.0.4" />
    <PackageReference Include="Dubacik22.ObservableDictionary" Version="1.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.20" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevalW.Services.Shared\RevalW.Services.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\jdk8u472-b08-jre\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>jre\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="Resources\fop\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>fop\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevalM.SharedStorage">
      <HintPath>..\Resources\RevalM.SharedStorage.dll</HintPath>
    </Reference>
    <Reference Include="RevalW.Shared">
      <HintPath>..\Resources\RevalW.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
